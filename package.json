{
  "name": "dealerpulse",
  "version": "1.0.0",
  "private": true,
  "description": "Sales performance dashboard for a multi-branch automotive dealership group",
  "scripts": {
    "dev": "node api.js && next dev",
    "build": "node api.js && next build",
    "start": "node api.js && next start",
    "lint": "eslint src --ext .js,.jsx,.ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@google/genai": "^2.30.0",
    "clsx": "2.1.1",
    "next": "^15.5.28",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "2.15.4"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.30"
    }
  },
  "devDependencies": {
    "@types/node": "20.16.11",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.1",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.1",
    "eslint-config-next": "^15.5.28",
    "postcss": "^8.5.30",
    "tailwindcss": "3.4.19",
    "typescript": "5.6.3",
    "vitest": "2.1.9"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
