# Optional: omit the key to use the offline curated answers.
ANTHROPIC_API_KEY=

# Set to false to force offline mode even when a key is configured.
ASK_AI_ENABLED=true

# Optional live-answer model and per-IP rate limits.
ASK_AI_MODEL=claude-opus-5-5
ASK_AI_RATE_LIMIT_PER_MINUTE=8
ASK_AI_RATE_LIMIT_PER_DAY=60
